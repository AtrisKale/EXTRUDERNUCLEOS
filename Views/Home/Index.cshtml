@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IViewLocalizer Localizer


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@{
    ViewData["Title"] = "Cuadros Centrales";
}

<div class="container text-center mt-5">
    <div class="row justify-content-center">
        <!-- Primer cuadro -->
        <div class="col-md-3">
            <a asp-controller="Impresoras" asp-action="STATUS" class="card-link">
                <div class="card shadow-sm">
                    <img src="~/images/iconoVJ2.png" class="card-img-top" alt="Productos">
                        <div class="card-body">
                            <h5 class="card-title">Impresoras</h5>
                            <p class="card-text">Status de Produccion</p>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Segundo cuadro -->
            <div class="col-md-3">
                <a asp-controller="Mtto" asp-action="Index" class="card-link">
                    <div class="card shadow-sm">
                        <img src="~/images/icono mtto.png" class="card-img-top" alt="Registro">
                            <div class="card-body">
                                <h5 class="card-title">MTTO</h5>
                                <p class="card-text">Historial de mtto de las impresoras</p>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Tercer cuadro -->
                <div class="col-md-3">
                    <a asp-controller="Impresoras" asp-action="Index" class="card-link">
                        <div class="card shadow-sm">
                            <img src="~/images/tablaicon.png" class="card-img-top" alt="Contacto">
                                <div class="card-body">
                                    <h5 class="card-title">Análisis</h5>
                                    <p class="card-text">Status de las impresoras</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>