@model List<EXTRUDERNUCLEOS.Models.Impresora>
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "Gestión de Impresoras";
    Layout = "_Layout2";

}


<h1>@ViewData["Title"]</h1>
@if (ViewBag.SinRegistros == true)
{
    <div class="alert alert-warning text-center mb-3">
        ⚠️ No existen registros en la base de datos. Captura la información inicial desde STATUS.
    </div>
}



<div class="row">
    <!-- Gráfica a la izquierda -->
    <div class="col-md-7">
        <div class="card shadow-sm mb-3 card-downtime">
            <div class="card-header bg-primary text-white text-center">
                <h6>Downtime del Mes</h6>
            </div>
            <div class="card-body p-1">
                <div style="height:200px;">
                    <canvas id="downtimeChart"></canvas>
                </div>
            </div>
        </div>
    </div>





    <!-- Card de horas núcleo a la derecha, ocupando mitad del ancho -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-3" style="height: 220px;">
            <div class="card-header bg-primary text-white text-center p-2"
                 style="position: sticky; top: 0; z-index: 10;">
                Horas núcleo restantes
            </div>
            <div class="card-body p-2" style="overflow-y:auto; height: calc(220px - 40px);">
                <div class="card-body p-2" style="overflow-y:auto; height: calc(220px - 40px);">
                    @foreach (var imp in Model.Where(x => x.Codigo != "3" && x.Codigo != "6"))
                    {
                        <small><strong>@imp.Codigo</strong></small>

                        @* Definimos el color según condición *@
                        var barraColor = "bg-info"; // azul por defecto
                        if (imp.InkCoreRemainingHours < 500 && imp.InkCoreRemainingHours >= 300)
                        {
                            barraColor = "bg-warning"; // naranja
                        }
                        else if (imp.InkCoreRemainingHours < 300)
                        {
                            barraColor = "bg-danger"; // rojo
                        }

                        <div class="progress mb-2" style="height: 14px;">
                            <div class="progress-bar @barraColor" role="progressbar"
                                 style="width:@(imp.InkCoreRemainingHours * 100 / 4000)%"
                                 aria-valuenow="@imp.InkCoreRemainingHours"
                                 aria-valuemin="0" aria-valuemax="4000">
                                <small>@imp.InkCoreRemainingHours h</small>
                            </div>
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>


    <tbody>

        <!-- Card con tabla -->
        <div class="card shadow-sm mb-3 card-impresoras">
            <div class="card-header bg-primary text-white text-center">
                <h6>Registro de Impresoras</h6>
            </div>

            <div class="card-body p-1 table-container-small">
                <form asp-action="ActualizarDesdeIndex" method="post">
                    <div class="table-responsive">

                        @if (Model == null || !Model.Any())
                        {
                            <div class="alert alert-warning text-center mb-2">
                                ⚠️ No existen registros en la base de datos. Puedes ingresar nuevos valores en la tabla.
                            </div>
                        }

                        <table class="table table-striped table-impresoras">
                            <thead>
                                <tr>
                                    <th>Extruder Locación</th>
                                    <th>Código</th>
                                    <th>Tipo</th>
                                    <th>Aditivo</th>
                                    <th>Horas de núcleo restantes</th>
                                    <th>Fecha</th>
                                    <th>Hora</th>
                                    <th>Status</th>
                                    <th>Tiempo Muerto</th>
                                    <th>Comentarios</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < 11; i++)
                                {
                                    if (i < Model.Count)
                                    {
                                        <tr>
                                            <td>
                                                <span class="view">@Model[i].LocationExtru</span>
                                                @Html.TextBoxFor(m => m[i].LocationExtru, new { @class = "form-control edit d-none" })
                                            </td>
                                            <td>
                                                <span class="view">@Model[i].Codigo</span>
                                                @Html.TextBoxFor(m => m[i].Codigo, new { @class = "form-control edit d-none" })
                                            </td>
                                            <td>
                                                <span class="view">@Model[i].Tipo</span>
                                                @Html.TextBoxFor(m => m[i].Tipo, new { @class = "form-control edit d-none" })
                                            </td>
                                            <td class="text-center">
                                                @(Model[i].Additive ? "Yes" : "No")
                                                @Html.TextBoxFor(m => m[i].Additive, new { @class = "form-control edit d-none" })
                                            </td>
                                            <td>
                                                <span class="view">@Model[i].InkCoreRemainingHours</span>
                                                @Html.TextBoxFor(m => m[i].InkCoreRemainingHours, new { @class = "form-control edit d-none", type="number" })
                                            </td>
                                            <td>
                                                <span class="view">@Model[i].Fecha.ToString("dd/MM/yyyy")</span>
                                                @Html.TextBoxFor(m => m[i].Fecha,"{0:yyyy-MM-dd}",new{@class = "form-control edit d-none",type = "date"})
                                            </td>
                                            <td>
                                                <span class="view">@Model[i].Hora.ToString(@"hh\:mm")</span>
                                                @Html.TextBoxFor(m => m[i].Hora,"{0:hh\\:mm}",new{@class = "form-control edit d-none",type = "time"})
                                            </td>
                                            <td>
                                                <span class="view">@Model[i].Status</span>
                                                @Html.TextBoxFor(m => m[i].Status, new { @class = "form-control edit d-none" })
                                            </td>
                                            <td>
                                                <span class="view">@Model[i].Downtime.ToString("0")</span>
                                                @Html.TextBoxFor(m => m[i].Downtime,"{0:0}", new {@class = "form-control edit d-none"})
                                            </td>
                                            <td>
                                                <span class="view">@Model[i].Comentario</span>
                                                @Html.TextBoxFor(m => m[i].Comentario, new { @class = "form-control edit d-none" })
                                            </td>
                                            @Html.HiddenFor(m => m[i].Id)
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td><input name="[@i].LocationExtru" class="form-control edit d-none" /></td>
                                            <td><input name="[@i].Codigo" class="form-control edit d-none" /></td>
                                            <td><input name="[@i].Tipo" class="form-control edit d-none" /></td>
                                            <td><input name="[@i].Additiv" class="form-control edit d-none" /></td>
                                            <td><input name="[@i].InkCoreRemainingHours" class="form-control edit d-none" type="number" /></td>
                                            <td><input name="[@i].Fecha" class="form-control edit d-none" type="date" /></td>
                                            <td><input name="[@i].Hora" class="form-control edit d-none" type="time" /></td>
                                            <td><input name="[@i].Status" class="form-control edit d-none" /></td>
                                            <td><input name="[@i].Downtime" class="form-control edit d-none" type="number" /></td>
                                            <td><input name="[@i].Comentario" class="form-control edit d-none" /></td>
                                            <input type="hidden" name="[@i].Id" value="0" />
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                        <button type="button" id="btnEditar" class="btn btn-warning btn-sm">Editar</button>
                        <button type="submit" id="btnGuardar" class="btn btn-success btn-sm d-none">Guardar</button>
                        <a asp-action="Historial" class="btn btn-info btn-sm">Ver Historial</a>
                    </div>


                </form>
            </div>
        </div>

    </tbody>

    

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

        <script>
            // Botones Editar/Guardar
            const btnEditar = document.getElementById("btnEditar");
            const btnGuardar = document.getElementById("btnGuardar");

            btnEditar.addEventListener("click", function () {
            document.querySelectorAll(".view").forEach(e => e.classList.add("d-none"));
            document.querySelectorAll(".edit").forEach(e => e.classList.remove("d-none"));
            btnGuardar.classList.remove("d-none");
            btnEditar.classList.add("d-none");
            });
        </script>


        <script>
            document.addEventListener("DOMContentLoaded", function () {
            const data = @Html.Raw(ViewBag.JsonDowntimeData);

            console.log("DATOS GRAFICA:", data);

            if (Array.isArray(data) && data.length > 0) {

            const labels = data.map(d => d.Fecha.split('-')[2]);

            const ctx = document.getElementById("downtimeChart").getContext("2d");

            new Chart(ctx, {
            type: "bar",
            data: {
            labels: labels,
            datasets: [{
            label: "Downtime diario",
            data: data.map(d => ({
            x: parseInt(d.Fecha.split('-')[2]),
            y: d.Total,
            Detalle: d.Detalle
            })),
            backgroundColor: "rgba(54, 162, 235, 0.6)",
            borderColor: "rgba(54, 162, 235, 1)",
            borderWidth: 1,

            // 👇 barras más delgadas para evitar que se encimen
            categoryPercentage: 0.7,
            barPercentage: 0.8
            }]
            },
            options: {

            // 👇 mejora detección del mouse
            interaction: {
            mode: 'nearest',
            intersect: true
            },

            responsive: true,
            maintainAspectRatio: false,

            plugins: {
            tooltip: {
            enabled: true,
            backgroundColor: "white",
            titleColor: "black",
            bodyColor: "black",
            borderColor: "rgba(54, 162, 235, 1)",
            borderWidth: 1,

            callbacks: {
            title: function (context) {
            return "Día " + context[0].label;
            },

            label: function (context) {

            let lines = [
            `Total : ${context.raw.y} min`
            ];

            if (
            context.raw.Detalle &&
            Array.isArray(context.raw.Detalle) &&
            context.raw.Detalle.length > 0
            ) {
            context.raw.Detalle.forEach(d => {
            lines.unshift(
            `${d.CodigoImpresora} : ${d.Downtime} min`
            );
            });
            }

            return lines;
            }
            }
            }
            },

            scales: {
            x: {
            offset: true
            },
            y: {
            beginAtZero: true
            }
            }
            }
            });
            }
            });
        </script>

    }
