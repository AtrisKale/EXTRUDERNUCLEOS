@model List<EXTRUDERNUCLEOS.Models.Impresora>

    @{
    ViewData["Title"] = "STATUS DE IMPRESORAS EN PRODUCCION";
    Layout = "_LayoutST";

    var impresorasTaller =
    ViewBag.ImpresorasTaller as List<EXTRUDERNUCLEOS.Models.Impresora>
    ?? new List<EXTRUDERNUCLEOS.Models.Impresora>
    ();


    }


    <h2 class="mb-4 text-center">STATUS DE IMPRESORAS EN PRODUCCION</h2>

    <form asp-action="ActualizarTodo" method="post">

        @if (ViewBag.SinRegistros == true)
        {
        <div class="alert alert-warning text-center mb-3">
            <strong>No existen registros en la base de datos.</strong>
            Captura la información inicial y presiona Guardar.
        </div>
        }

        <div class="row">

            <!-- Extruder 1 -->
            <div class="col-md-4">
                <div class="card shadow-sm mb-3">
                    <video autoplay loop muted playsinline preload="metadata" class="card-img-top">
                        <source src="~/videos/extruder_sin_bordes_negros.mp4" type="video/mp4">
                    </video>
                    <div class="card-body">
                        <!-- TÍTULO + ADITIVO EN LA MISMA LÍNEA -->
                        <div class="titulo-con-aditivo">
                            <h5 class="card-title"> Extruder 1 Videojet</h5>
                            <div class="aditivo-titulo">
                                <input asp-for="@Model[0].Additive" type="checkbox" class="form-check-input" />
                                <label asp-for="@Model[0].Additive"> Aditivo </label>
                            </div>
                        </div>
                        <!-- DATOS OCULTOS -->
                        <input type="hidden" asp-for="@Model[0].Id" />
                        <input type="hidden" asp-for="@Model[0].LocationExtru" value="1" />
                        <input type="hidden" asp-for="@Model[0].Tipo" value="VIDEOJET" />
                        <!-- ID VIDEOJET -->
                        <label>ID Videojet</label>
                        <input asp-for="@Model[0].Codigo" class="form-control form-control-sm" />
                        <!-- HORAS NÚCLEO -->
                        <label>Horas núcleo restantes</label>
                        <input asp-for="@Model[0].InkCoreRemainingHours" class="form-control form-control-sm" />
                        <!-- TIEMPO MUERTO -->
                        <label>Tiempo muerto</label>
                        <input asp-for="@Model[0].Downtime" value="@Model[0].Downtime.ToString(" 0")" type="number" step="1" min="0" class="form-control form-control-sm" />
                        <!-- STATUS Y COMENTARIO -->
                        <input type="hidden" asp-for="@Model[0].Status" value="PRODUCCION" />
                        <input type="hidden" asp-for="@Model[0].Comentario" value="SIN COMENTARIOS" />
                    </div>
                </div>
            </div>


            <!-- EXT # 2 -->
