                    </video>

                    <div class="card-body">
                        <h5 class="card-title">Extruder 2 Videojet</h5>

                        <input type="hidden" asp-for="@Model[1].Id" />
                        <input type="hidden" asp-for="@Model[1].LocationExtru" value="2" />
