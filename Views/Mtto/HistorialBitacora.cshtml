@model List<EXTRUDERNUCLEOS.Models.Bitacora>

@{
    ViewData["Title"] = "Historial de Bitácora";
    Layout = "_LayoutMtto";
}

<h2>Historial de Bitácora</h2>

<form asp-action="HistorialBitacora" method="get" class="mb-3">
    <div class="input-group">
        <input type="number"
               name="filtroId"
               class="form-control"
               placeholder="Filtrar por ID Videojet"
               value="@ViewBag.FiltroId" />

        <button type="submit" class="btn btn-secondary">
            Filtrar
        </button>

        <a asp-action="HistorialBitacora"
               class="btn btn-outline-dark">
            Quitar filtro
        </a>
    </div>
</form>

<div class="mb-3">

    <a asp-action="Bitacora"
           class="btn btn-primary">
        Regresar a Bitácora
    </a>

    <button type="button"
            class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#modalExportar">
        Exportar Excel
    </button>

</div>


@if (!Model.Any())
{
    <div class="alert alert-warning text-center">
        ⚠ No existen registros.
    </div>
}

<table class="table table-striped table-sm text-center">
    <thead>
        <tr>
            <th>ID Videojet</th>
            <th>Motivo de mtto</th>
            <th>Procedimiento</th>
            <th>Fecha</th>
            <th>Turno</th>
            <th>Pendientes</th>
        </tr>
    </thead>

    <tbody>

        @for (int i = 0; i < Math.Max(Model.Count, 10); i++)
        {
            if (i < Model.Count)
            {
                <tr>
                    <td>@Model[i].IdVideojet</td>
                    <td>@Model[i].MotivoMtto</td>
                    <td>@Model[i].Procedimiento</td>
                    <td>@Model[i].Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@Model[i].Turno</td>
                    <td>@Model[i].Pendientes</td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="6">&nbsp;</td>
                </tr>
            }
        }

    </tbody>
</table>

<div class="modal fade"
     id="modalExportar"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form asp-action="DescargarExcelFiltrado"
                  asp-controller="Mtto"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">
                        Exportar Bitácora
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    @* ==========================================
                        MENSAJE DE ERROR DE EXPORTACIÓN
                        ========================================== *@

                    @if (TempData["ErrorExportacion"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show"
                             role="alert">

                            <strong>⚠ Filtro no encontrado</strong>

                            <br />

                            @TempData["ErrorExportacion"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Cerrar">
                            </button>

                        </div>
                    }

                    @* ==========================================
                        COLUMNAS
                        ========================================== *@

                    <h6>Columnas a exportar</h6>

                    <hr />

                    <h6>Registros a exportar</h6>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="TipoExportacion"
                               value="Mes"
                               checked />

                        <label>Solo mes actual</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="TipoExportacion"
                               value="Todo" />

                        <label>Todo el historial</label>
                    </div>


                    @* ==========================================
                        FILTRO POR ID VIDEOJET
                        ========================================== *@

                    <div class="form-check mt-3">

                        <input id="chkFiltrarVideojet"
                               class="form-check-input"
                               type="checkbox"
                               name="FiltrarVideojet"
                               value="true" />

                        <label class="form-check-label">
                            Filtrar por ID Videojet
                        </label>

                    </div>

                    <input type="number"
                           class="form-control mb-2"
                           id="txtVideojet"
                           name="FiltroVideojet"
                           placeholder="ID Videojet"
                           disabled />


                    @* ==========================================
                        FILTRO POR FECHAS
                        ========================================== *@

                    <div class="form-check">

                        <input id="chkFiltrarFechas"
                               class="form-check-input"
                               type="checkbox"
                               name="FiltrarFechas"
                               value="true" />

                        <label class="form-check-label">
                            Filtrar por rango de fechas
                        </label>

                    </div>

                    <div class="row">

                        <div class="col">

                            <input type="date"
                                   class="form-control"
                                   id="fechaInicio"
                                   name="FechaInicio"
                                   disabled />

                        </div>

                        <div class="col">

                            <input type="date"
                                   class="form-control"
                                   id="fechaFin"
                                   name="FechaFin"
                                   disabled />

                        </div>

                    </div>

                    <hr />


                    @* ==========================================
                        COLUMNAS A EXPORTAR
                        ========================================== *@

                    <div class="form-check">
                        <input id="chkIdVideojet"
                               class="form-check-input"
                               type="checkbox"
                               name="IdVideojet"
                               value="true" />

                        <label class="form-check-label">
                            ID Videojet
                        </label>
                    </div>

                    <div class="form-check">
                        <input id="chkMotivo"
                               class="form-check-input"
                               type="checkbox"
                               name="MotivoMtto"
                               value="true" />

                        <label class="form-check-label">
                            Motivo de mtto
                        </label>
                    </div>

                    <div class="form-check">
                        <input id="chkProcedimiento"
                               class="form-check-input"
                               type="checkbox"
                               name="Procedimiento"
                               value="true" />

                        <label class="form-check-label">
                            Procedimiento
                        </label>
                    </div>

                    <div class="form-check">
                        <input id="chkFecha"
                               class="form-check-input"
                               type="checkbox"
                               name="Fecha"
                               value="true" />

                        <label class="form-check-label">
                            Fecha
                        </label>
                    </div>

                    <div class="form-check">
                        <input id="chkTurno"
                               class="form-check-input"
                               type="checkbox"
                               name="Turno"
                               value="true" />

                        <label class="form-check-label">
                            Turno
                        </label>
                    </div>

                    <div class="form-check">
                        <input id="chkPendientes"
                               class="form-check-input"
                               type="checkbox"
                               name="Pendientes"
                               value="true" />

                        <label class="form-check-label">
                            Pendientes
                        </label>
                    </div>

                    <hr />

                    <div class="form-check">
                        <input id="chkTodo"
                               class="form-check-input"
                               type="checkbox"
                               name="Todo"
                               value="true" />

                        <label class="form-check-label">
                            Exportar todas las columnas
                        </label>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Exportar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>



@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // =========================
            // ABRIR MODAL SI HUBO ERROR
            // =========================

            @if (TempData["ErrorExportacion"] != null)
            {
                    <text>
                            const modalError = new bootstrap.Modal(
                            document.getElementById("modalExportar")
                            );

                            modalError.show();
                    </text>
            }


            // =========================
            // COLUMNAS
            // =========================

            const chkTodo = document.getElementById("chkTodo");

            const columnas = [
                document.getElementById("chkIdVideojet"),
                document.getElementById("chkMotivo"),
                document.getElementById("chkProcedimiento"),
                document.getElementById("chkFecha"),
                document.getElementById("chkTurno"),
                document.getElementById("chkPendientes")
            ];

            chkTodo.addEventListener("change", function () {

                if (chkTodo.checked) {

                    columnas.forEach(c => {
                        c.checked = true;
                        c.disabled = true;
                    });

                } else {

                    columnas.forEach(c => {
                        c.checked = false;
                        c.disabled = false;
                    });

                }

            });


            // =========================
            // FILTRO VIDEOJET
            // =========================

            const chkFiltrarVideojet =
                document.getElementById("chkFiltrarVideojet");

            const txtVideojet =
                document.getElementById("txtVideojet");

            if (chkFiltrarVideojet) {

                chkFiltrarVideojet.addEventListener("change", function () {

                    txtVideojet.disabled = !this.checked;

                    if (!this.checked) {
                        txtVideojet.value = "";
                    }

                });

            }


            // =========================
            // FILTRO FECHAS
            // =========================

            const chkFiltrarFechas =
                document.getElementById("chkFiltrarFechas");

            const fechaInicio =
                document.getElementById("fechaInicio");

            const fechaFin =
                document.getElementById("fechaFin");

            if (chkFiltrarFechas) {

                chkFiltrarFechas.addEventListener("change", function () {

                    fechaInicio.disabled = !this.checked;
                    fechaFin.disabled = !this.checked;

                    if (!this.checked) {

                        fechaInicio.value = "";
                        fechaFin.value = "";

                    }

                });

            }

        });

    </script>
}