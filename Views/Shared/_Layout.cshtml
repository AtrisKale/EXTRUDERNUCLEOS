@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TGProyecto</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TGProyecto.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/iCona.png" />

    <!-- CSS exclusivo para Index -->
    <style>
    </style>





</head>
<body>
    <header>
        <!-- Barra superior general -->
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/tgicon.jpg" alt="Logo" class="sidebar-image" />
                </a>
                <a asp-action="Login" class="btn btn-primary">Cerrar sesión</a>
            </div>
        </nav>
    </header>
    <style>
    .card-link {
    text-decoration: none;
    color: inherit;
    }
    .card {
    transition: transform 0.2s ease-in-out;
    }
    .card:hover {
    transform: scale(1.05);
    }
    .sidebar-image {
                width:100px; /* 🔹 ancho de la imagen */
                height: auto; /* 🔹 mantiene proporción */
                display: block; /* 🔹 asegura que se centre */
                margin: 0 auto; /* 🔹 centra horizontalmente */
               
            }


</style>


<script>
function changeLanguage(lang) {
    const currentPath = window.location.pathname; // mantiene la vista actual
    window.location.href = currentPath + "?culture=" + lang + "&ui-culture=" + lang;
}
</script>





    <div class="main-content">
        @RenderBody()
    </div>

    

</body>
</html>