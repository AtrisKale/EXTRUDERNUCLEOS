<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "Toyoda Gosei") - TGPro</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="icon"
          type="image/png"
          href="~/images/iCona.png" />

    <style>

        /* =========================================
           RESETEO GENERAL
           Quita espacios blancos exteriores
           ========================================= */

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100%;
            min-height: 100%;
        }

        body {
            overflow-x: hidden;
        }

        .container-fluid {
            margin: 0 !important;
            padding: 0 !important;
        }


        /* =========================================
           SIDEBAR
           ========================================= */

        .sidebar {
            width: 220px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            margin: 0 !important;
            padding: 0;
            background-color: #2c3e50;
            transition: all 0.3s ease;
            z-index: 1000;
        }

            .sidebar .logo {
                width: 120px;
            }

        .sidebar-link {
            display: block;
            width: 100%;
            padding: 12px 0;
            text-align: center;
            color: #ffffff;
            text-decoration: none;
            font-weight: 500;
            transition: background-color 0.3s, color 0.3s;
        }

            .sidebar-link:hover {
                background-color: #1e3a6b;
                color: #00aaff;
            }


        /* =========================================
           CONTENIDO PRINCIPAL
           ========================================= */

        .content-area {
            margin-left: 220px;
            padding: 20px;
        }


        /* =========================================
           TÍTULOS
           ========================================= */

        h1 {
            font-size: 1.9rem;
            margin-bottom: 0.5rem;
        }

        .card-header h6 {
            font-size: 0.65rem;
            margin: 0;
        }


        /* =========================================
           CARDS
           ========================================= */

        .card {
            border-radius: 8px;
            overflow: hidden;
        }

        .card-body {
            padding: 0.5rem;
        }

        .card-title {
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        .card label {
            font-size: 0.85rem;
            margin-bottom: 0.25rem;
            display: block;
        }

        .card input {
            font-size: 0.85rem;
            padding: 0.25rem 0.5rem;
        }


        /* =========================================
           TABLAS
           ========================================= */

        .table th,
        .table td {
            text-align: center;
            vertical-align: middle;
        }


        /* =========================================
           GRÁFICAS
           ========================================= */

        canvas {
            max-height: 300px;
            max-width: 100%;
        }


        /* =========================================
           VIDEOS DE STATUS PRODUCCIÓN
           ========================================= */

        video.card-img-top {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
            background: transparent;
            border: 0 !important;
            outline: 0 !important;
        }


        /* =========================================
           EXT 3, 4, 5 Y 6
           ========================================= */

        video.video-large,
        video.video-medium {
            width: 100%;
            height: auto;
            object-fit: cover;
            display: block;
            background: transparent;
            border: 0 !important;
            outline: 0 !important;
        }


        /* =========================================
           VIDEO DEL TALLER
           ========================================= */

        video.videotaller {
            width: 100%;
            height: 380px;
            object-fit: cover;
            border-radius: 0;
            display: block;
        }


        .label-id-tinta {
            display: flex;
            align-items: center;
            gap: 6px;
            height: 18px;
        }

            .label-id-tinta label {
                margin: 0 !important;
                line-height: 1;
            }

        .badge-tinta-amarilla {
            display: inline-block;
            background-color: #ffc107;
            color: #212529;
            font-size: 0.62rem;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 4px;
            line-height: 1.2;
            white-space: nowrap;
        }

        /* =========================================
   TÍTULO + CHECKBOX ADITIVO
   ========================================= */

        .titulo-con-aditivo {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 2px;
        }

            .titulo-con-aditivo .card-title {
                margin: 0;
            }

        .aditivo-titulo {
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .aditivo-titulo input[type="checkbox"] {
                width: 15px;
                height: 15px;
                margin: 0 !important;
            }

            .aditivo-titulo label {
                margin: 0 !important;
                color: #0d6efd;
                font-weight: 600;
                line-height: 1;
            }


        /* =========================================
           AJUSTE PARA TV / PANTALLA GRANDE
           ========================================= */

        @@media screen and (min-width: 1600px) {
            /* =========================================
               SIDEBAR TV
               ========================================= */

            .sidebar {
                width: 230px;
            }

                .sidebar .logo {
                    width: 115px;
                    margin-bottom: 20px !important;
                }

            .sidebar-link {
                font-size: 0.95rem;
                padding: 10px 6px;
            }
            /* =========================================
               ÁREA PRINCIPAL
               ========================================= */

            .content-area {
                margin-left: 230px;
                width: calc(100% - 230px);
                max-width: calc(100% - 230px);
                padding: 0 16px 8px 16px;
                box-sizing: border-box;
            }
            /* =========================================
               TÍTULO
               ========================================= */

            h1 {
                font-size: 1.7rem;
                margin-top: 5px;
                margin-bottom: 8px;
                line-height: 1.1;
            }
            /* =========================================
               ESPACIO ENTRE CARDS
               ========================================= */

            .row {
                --bs-gutter-x: 0.8rem;
                --bs-gutter-y: 0.65rem;
            }
            /* =========================================
               CARDS
               ========================================= */

            .card {
                border-radius: 7px;
                overflow: hidden;
            }
                /*
               Evita espacio alrededor del video
               cuando está directamente dentro del card
            */

                .card > video.card-img-top {
                    margin: 0 !important;
                    padding: 0 !important;
                }

            .card-body {
                padding: 0.4rem 0.6rem;
            }

            .card-title {
                font-size: 0.95rem;
                margin-bottom: 0.2rem;
                line-height: 1.15;
            }
            /* =========================================
               LABELS
               ========================================= */

            .card label {
                font-size: 0.78rem;
                margin-bottom: 1px;
                line-height: 1.05;
            }
            /* =========================================
               INPUTS
               ========================================= */

            .card input,
            .card select {
                height: 28px;
                font-size: 0.78rem;
                padding: 2px 7px;
                margin-bottom: 2px;
                line-height: 1;
            }
                /* =========================================
               CHECKBOX ADITIVO
               ========================================= */

                .card input[type="checkbox"] {
                    width: 15px;
                    height: 15px;
                    margin-right: 4px;
                    margin-bottom: 0;
                }
            /* =========================================
               VIDEOS NORMALES
               EXT 1, EXT 2 Y RETRABAJO
               ========================================= */
           
            video.card-img-top {
                width: 100%;
                height: auto;
                object-fit: contain;
                object-position: center;
                display: block;
                background: transparent;
                border: 0 !important;
                outline: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            /* =========================================
               EXT 3 Y EXT 6
               ========================================= */

            video.video-large {
                width: 100%;
                height: 125px;
                object-fit: cover;
                object-position: center;
                display: block;
                background-color: #e5f3f6;
                border: 0 !important;
                outline: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            /* =========================================
               EXT 4 Y EXT 5
               ========================================= */

            video.video-medium {
                width: 100%;
                height: 125px;
                object-fit: cover;
                object-position: center;
                display: block;
                background-color: #e5f3f6;
                border: 0 !important;
                outline: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            /* =========================================
               BOTONES
               ========================================= */

            .btn {
                font-size: 0.82rem;
                padding: 0.3rem 0.65rem;
            }
            /* =========================================
               TABLAS SI LLEGARAN A APARECER
               ========================================= */

            .table {
                font-size: 0.78rem;
            }

                .table th,
                .table td {
                    padding: 0.3rem;
                }
        }
    </style>

</head>


<body>

    <div class="container-fluid">

        <div class="row">


            <!-- =====================================
                 SIDEBAR
                 ===================================== -->

            <div class="col-auto sidebar text-white p-0">

                <div class="d-flex flex-column align-items-center pt-3">

                    <img src="~/images/tgrmxi.png"
                         alt="Toyoda Gosei"
                         class="logo mb-3">


                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link">
                        Inicio
                    </a>


                    <a asp-controller="Mtto"
                       asp-action="Taller"
                       class="sidebar-link">
                        Status Taller de Impresoras
                    </a>


                    <a asp-controller="Impresoras"
                       asp-action="Index"
                       class="sidebar-link">
                        Analisis
                    </a>


                    <a asp-controller="Home"
                       asp-action="Login"
                       class="sidebar-link">
                        Cerrar sesión
                    </a>

                </div>

            </div>


            <!-- =====================================
                 CONTENIDO PRINCIPAL
                 ===================================== -->

            <div class="col content-area">

                @RenderBody()

            </div>


        </div>

    </div>


    <!-- =========================================
         SCRIPTS
         ========================================= -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)


</body>

</html>