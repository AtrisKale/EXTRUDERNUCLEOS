<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Toyoda Gosei") - TGPro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    
    <link rel="icon" type="image/png" href="~/images/iCona.png" />

  


    <style>
            /* Sidebar */
            .sidebar {
                width: 220px;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                background-color: #2c3e50;
                transition: all 0.3s ease;
            }

                .sidebar .logo {
                    width: 120px;
                }

            .sidebar-link {
                display: block;
                width: 100%;
                padding: 12px 0;
                text-align: center;
                color: #ffffff;
                text-decoration: none;
                font-weight: 500;
                transition: background-color 0.3s, color 0.3s;
            }

            /* Ajuste de tamaño para títulos principales */
            h1 {
                font-size: 1.9rem; /* más pequeño */
                margin-bottom: 0.5rem;
            }

            /* Si tu título está dentro de la tarjeta */
            .card-header h6 {
                font-size: 0.65rem; /* reduce aún más */
                margin: 0;
            }



            .sidebar-link:hover {
                background-color: #1e3a6b;
                color: #00aaff;
            }

            /* Contenido principal */
        .content-area {
            margin-left: 220px;
            width: calc(100% - 220px);
            max-width: calc(100% - 220px);
            padding: 20px;
            box-sizing: border-box;
        }

            /* Card */
            .card {
                border-radius: 8px;
                overflow: hidden;
            }

            /* Centrado de tablas */
            .table th, .table td {
                text-align: center;
                vertical-align: middle;
            }

            /* Ajustes de tamaño */
            .card-body {
                padding: 0.75rem;
            }

            canvas {
                max-height: 300px; /* altura máxima */
                max-width: 100%; /* 🔧 ocupa todo el ancho disponible */
            }

            /* Aplica a todos los videos en cards normales */
            video.card-img-top {
                object-fit: cover;
                width: 100%;
                height: 110px; /* compacto */
                display: block;
            }

            /* Variante para los cards dobles (Extruder 3 y 6) */
            video.video-large {
                height: 180px; /* más alto */
            }

            /* Variante para Extruder 4 y 5 */
            video.video-medium {
                height: 160px; /* intermedio, más cómodo */
            }

            /* Variante para Extruder 4 y 5 */
            video.videotaller {
                width: 100%; /* ocupa todo el ancho */
                height: 450px; /* ocupa toda la altura del card */
                object-fit: cover; /* recorta el video para llenar sin bordes */
                border-radius: 0; /* opcional, sin esquinas redondeadas */
                display: block;
            }


            .card-body {
                padding: 0.5rem;
            }

            .card-title {
                font-size: 1rem;
                margin-bottom: 0.5rem;
            }

            .card label {
                font-size: 0.85rem;
                margin-bottom: 0.25rem;
                display: block;
            }

            .card input {
                font-size: 0.85rem;
                padding: 0.25rem 0.5rem;
 }



        /* =========================================
   AJUSTE TV / PANTALLA GRANDE
   ========================================= */

        @@media screen and (min-width: 1600px) {

            .sidebar {
                width: 260px;
            }

                .sidebar .logo {
                    width: 145px;
                }

            .sidebar-link {
                font-size: 1.05rem;
                padding: 15px 8px;
            }

            .content-area {
                margin-left: 260px;
                width: calc(100% - 260px);
                max-width: calc(100% - 260px);
                padding: 25px 30px;
                box-sizing: border-box;
            }

            h1 {
                font-size: 2.2rem;
            }

            h2 {
                font-size: 1.8rem;
            }

            .card-title {
                font-size: 1.15rem;
            }

            .card label {
                font-size: 0.95rem;
            }

            .card input,
            .card select,
            .card button {
                font-size: 0.95rem;
            }

            .table {
                font-size: 0.90rem;
            }
        }


        /* =========================================
   AJUSTE TV / PANTALLA GRANDE
   ========================================= */

        @@media screen and (min-width: 1600px) {

            .sidebar {
                width: 260px;
            }

                .sidebar .logo {
                    width: 145px;
                }

            .sidebar-link {
                font-size: 1.05rem;
                padding: 15px 8px;
            }

            .content-area {
                margin-left: 260px;
                width: calc(100% - 260px);
                max-width: calc(100% - 260px);
                padding: 25px 30px;
                box-sizing: border-box;
            }

            h1 {
                font-size: 2.2rem;
            }

            h2 {
                font-size: 1.8rem;
            }

            .card-title {
                font-size: 1.15rem;
            }

            .card label {
                font-size: 0.95rem;
            }

            .card input,
            .card select,
            .card button {
                font-size: 0.95rem;
            }

            .table {
                font-size: 0.90rem;
            }
        }




        /* ===============================
   AJUSTE PARA TV / PANTALLA GRANDE
   =============================== */

        @@media screen and (min-width: 1600px) {

            .sidebar {
                width: 260px;
            }

                .sidebar .logo {
                    width: 145px;
                }

            .sidebar-link {
                font-size: 1.05rem;
                padding: 15px 8px;
            }

            .content-area {
                margin-left: 260px;
                width: calc(100% - 260px);
                max-width: calc(100% - 260px);
                padding: 25px 30px;
                box-sizing: border-box;
            }

            h1 {
                font-size: 2.2rem;
            }

            h2 {
                font-size: 1.8rem;
            }

            .card-header h6 {
                font-size: 0.85rem;
            }

            .card-title {
                font-size: 1.15rem;
            }

            .card label {
                font-size: 0.95rem;
            }

            .card input,
            .card select,
            .card textarea {
                font-size: 0.95rem;
                padding: 0.4rem 0.6rem;
            }

            .btn {
                font-size: 0.95rem;
                padding: 0.5rem 0.9rem;
            }

            .card-body {
                padding: 0.75rem;
            }

            video.card-img-top {
                height: 140px;
            }

            video.video-large {
                height: 220px;
            }

            video.video-medium {
                height: 200px;
            }
            /* El video del Taller ya es bastante grande.
       Lo dejamos igual para evitar que empuje botones. */
            video.videotaller {
                height: 450px;
            }
        }

    </style>

</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-auto sidebar text-white p-0">
                <div class="d-flex flex-column align-items-center pt-3">
                    <img src="~/images/tgrmxi.png" alt="Toyoda Gosei" class="logo mb-3">
                        <a asp-controller="Home" asp-action="Index" class="sidebar-link">Inicio</a>
                        <a asp-controller="Impresoras" asp-action="STATUS" class="sidebar-link">Status Producción</a>
                        <a asp-controller="Impresoras" asp-action="Index" class="sidebar-link">Analisis</a>
                        <a asp-controller="Home" asp-action="Login" class="sidebar-link">Cerrar sesión</a>
                    </div>
                </div>

                <!-- Contenido principal -->
                <div class="col content-area">
                    @RenderBody()
                </div>
            </div>
        </div>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        @RenderSection("Scripts", required: false)
    </body>
</html>